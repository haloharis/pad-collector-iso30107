{
  "expo": {
    "name": "PAD Collector",
    "slug": "pad-collector",
    "scheme": "padcollector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.datamatics.padcollector",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to record your video clips."
      }
    },
    "android": {
      "package": "com.datamatics.padcollector",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "This app needs camera access to record your video clips.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": false,
          "enableCodeScanner": false
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-video",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b40cae6f-9526-4a1f-ae6a-d374bb86b7fa"
      }
    },
    "owner": "halohariss-team"
  }
}
